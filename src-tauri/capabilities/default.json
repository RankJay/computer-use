{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core + opener + explicit Actuate native commands (see permissions/actuate-native.toml).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "opener:default",
    "allow-capture-primary-display",
    "allow-run-command",
    "allow-pointer-move-to",
    "allow-pointer-click",
    "allow-type-text",
    "allow-key-tap",
    "allow-pointer-automation-lifecycle",
    "allow-ui-a11y",
    "allow-display-info",
    "allow-clipboard",
    "allow-load-settings",
    "allow-save-settings",
    "allow-load-secret",
    "allow-store-secret",
    "allow-delete-secret",
    "allow-append-session-log",
    "allow-write-session-keyframe",
    "allow-clear-all-logs",
    "allow-open-logs-folder",
    "allow-read-workspace-file",
    "allow-list-workspace-dir",
    "allow-write-workspace-file",
    {
      "identifier": "http:default",
      "allow": ["https://api.anthropic.com/*"]
    }
  ]
}

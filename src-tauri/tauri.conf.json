{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "actuate",
  "version": "0.2.0",
  "identifier": "com.rankj.actuate",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "actuate",
        "width": 410,
        "height": 720,
        "visible": false,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["actuate"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCQTkzQjMzRTY0QjVCNTIKUldSU1cwdm1NenVwNnpXYXkwZHFEYTJvWGNTZHhNYTc0MEFidVcvOVUrckJxdWxjRWRmRXpERDUK",
      "endpoints": ["https://actuate-be.vercel.app/api/releases/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
